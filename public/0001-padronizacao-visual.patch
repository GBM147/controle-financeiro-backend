+/* ===== CABEÇALHO E MENU LATERAL GBM (compartilhado) ===== */
+.gbm-header {
+  background: transparent;
+  border-bottom: 1px solid var(--borda);
+  padding: 0 20px;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
