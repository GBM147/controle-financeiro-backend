+/* Acabamento aprovado: superfícies profundas, detalhes azuis e hierarquia mais clara. */
+body.gbm-interna .page-title {
+    display: flex;
+    align-items: flex-end;
+    justify-content: space-between;
+    gap: 20px;
+    padding-bottom: 16px;
+    border-bottom: 1px solid rgba(255, 255, 255, .08);
+}
+
+body.gbm-interna .page-title h1 { font-weight: 700; }
+
+body.gbm-interna .stat {
+    min-height: 118px;
+    display: grid;
+    align-content: space-between;
+    gap: 14px;
+    text-transform: none;
+}
+
+body.gbm-interna .stat strong {
+    font-size: clamp(1.45rem, 3vw, 2rem);
+    letter-spacing: -.35px;
+}
+
+body.gbm-interna :is(input, select, textarea) {
+    border-color: rgba(255, 255, 255, .11);
+    border-radius: 10px;
+    background: rgba(12, 27, 45, .86);
+}
+
+body.gbm-interna :is(input, select, textarea):focus {
+    border-color: rgba(85, 167, 255, .65);
+    box-shadow: 0 0 0 3px rgba(85, 167, 255, .11);
+}
+
+body.gbm-interna table tbody tr { transition: background .2s ease; }
+body.gbm-interna table tbody tr:hover { background: rgba(85, 167, 255, .045); }
+
+.grafico-cabecalho {
+    display: flex;
+    align-items: flex-start;
+    justify-content: space-between;
+    gap: 16px;
+    margin-bottom: 16px;
+}
+
+.grafico-cabecalho h2 { margin: 0; }
+.grafico-cabecalho .field { min-width: 165px; }
+.relatorio-grafico-wrapper { position: relative; min-height: 310px; }
+.relatorio-grafico-wrapper canvas { max-height: 310px; }
+
+@media (max-width: 760px) {
+    body.gbm-interna .page-title,
+    .grafico-cabecalho {
+        align-items: stretch;
+        flex-direction: column;
+    }
+
+    .grafico-cabecalho .field { min-width: 0; }
+    .relatorio-grafico-wrapper { min-height: 270px; }
+}
+
+/* ===== ALINHAMENTO VISUAL DO DASHBOARD À RÉGUA CANÔNICA ===== */
