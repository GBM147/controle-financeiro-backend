+    transition: letter-spacing 0.3s ease, transform 0.3s ease;
+    text-shadow: none !important;
+}
+
+.gbm-title:hover {
+    letter-spacing: 4px;
+    transform: scale(1.03);
+    animation-duration: 1.5s; /* acelera o brilho no hover */
