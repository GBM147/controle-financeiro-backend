NODE_ENV=production
PORT=10000

# MySQL
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=controle_gastos
DB_SSL=true
# TLS sempre verifica certificado e hostname; o valor legado false é ignorado.
DB_SSL_REJECT_UNAUTHORIZED=true
# Opcional: caminho de um certificado CA PEM confiável fornecido pelo provedor.
DB_SSL_CA_FILE=
# DB_SSL=false é permitido somente em desenvolvimento com banco no loopback.

# Endereço público do projeto. Para mais de uma origem, separe por vírgula.
APP_URL=https://gbm-finance.com
ALLOWED_ORIGINS=https://gbm-finance.com

# Gere valores longos e aleatórios e não os publique no GitHub.
SESSION_SECRET=
DATA_ENCRYPTION_KEY=
EMAIL_INDEX_KEY=

# Google Gemini (leitura assistida de extratos PDF)
GEMINI_API_KEY=
# Modelo estável validado para o parser. Permite migração sem alterar o código.
GEMINI_MODEL=gemini-3.6-flash

# Mercado Pago
MP_ACCESS_TOKEN=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend
RESEND_API_KEY=
EMAIL_SUPORTE=suporte@seu-dominio.com
